# Copy to .env and fill in. The attack pipeline reads SILICONFLOW_API_KEY from
# the environment; .env is NOT auto-loaded — source it manually or use a tool
# like direnv / python-dotenv if you prefer.

# Required: SiliconFlow account for DeepSeek-V3.2 access.
# Get a key at https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: cache directory for sentence-transformers (MiniLM weights ~90MB).
# Defaults to ~/.cache/huggingface/. Set this to a project-local path if you
# want the model cached inside the repo (don't commit the weights though).
# HF_HOME=/path/to/hf_cache

# Optional: pin sentence-transformers model name (default already correct).
# MINILM_MODEL=sentence-transformers/all-MiniLM-L6-v2
